# Umami Analytics
PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here
PUBLIC_UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js

# Bible API (NKJV)
# WARNING: If your API requires a secret key, DO NOT expose it in frontend code
# Use a serverless proxy (Netlify/Vercel Functions, Cloudflare Workers, etc.)
PUBLIC_BIBLE_API_URL=https://api.scripture.api.bible/v1
# BIBLE_API_KEY=your-secret-key (use backend proxy only)

# YouTube
PUBLIC_YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxx
PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@MahanamiChurch

# Church Info
PUBLIC_CHURCH_NAME=Mahanaim Christian Church
PUBLIC_CHURCH_EMAIL=info@mahanaim-church.org
PUBLIC_CHURCH_PHONE=+1-555-123-4567

# Map Center (default location)
PUBLIC_MAP_CENTER_LAT=34.0522
PUBLIC_MAP_CENTER_LNG=-118.2437
PUBLIC_MAP_ZOOM=10

# Custom Domain (for canonical URLs)
PUBLIC_SITE_URL=https://mahanaim-church.org
