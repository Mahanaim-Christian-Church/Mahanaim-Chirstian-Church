---
const articleModules = import.meta.glob('../content/articles/*.md', { query: '?raw', import: 'default', eager: true });

function parseArticle(raw, fallbackSlug) {
  const source = String(raw);
  const frontmatterMatch = source.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  const frontmatter = frontmatterMatch ? frontmatterMatch[1] : '';
  const body = frontmatterMatch ? frontmatterMatch[2].trim() : source.trim();
  const data = {};

  frontmatter.split('\n').forEach(line => {
    const index = line.indexOf(':');
    if (index === -1) return;
    const key = line.slice(0, index).trim();
    const value = line.slice(index + 1).trim().replace(/^['"]|['"]$/g, '');
    data[key] = value;
  });

  return {
    slug: data.slug || fallbackSlug,
    title: data.title || 'Untitled Article',
    author: data.author || 'Mahanaim Christian Church',
    date: data.date || '',
    image: data.image || '',
    excerpt: data.excerpt || body.slice(0, 180),
    body
  };
}

const articles = Object.entries(articleModules)
  .map(([path, raw]) => parseArticle(raw, path.split('/').pop().replace('.md', '')))
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Articles | Mahanaim Christian Church</title>
  <link rel="icon" type="image/png" href="../assets/mahanaim-logo.png" />
  <link rel="stylesheet" href="../style.css?v=20260609-map" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href="../"><img src="../assets/mahanaim-logo.png" alt="Mahanaim Christian Church logo" /><span><strong>Mahanaim</strong> Christian Church</span></a>
    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav">
      <a href="../about/" data-icon="i" data-label="About">About</a>
      <a href="../ministries/" data-icon="✦" data-label="Ministries">Ministries</a>
      <a href="../sermons/" data-icon="▶" data-label="Sermons">Sermons</a>
      <a href="../community/" data-icon="●" data-label="Community">Community</a>
      <a href="../events/" data-icon="◷" data-label="Events">Events</a>
      <a href="../locations/" data-icon="⌖" data-label="Locations">Locations</a>
      <a class="active" href="./" data-icon="¶" data-label="Articles">Articles</a>
      <a href="../contact/" data-icon="@" data-label="Contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="section articles-page">
      <div class="articles-hero">
        <p class="eyebrow">Articles & Devotions</p>
        <h1 class="page-title">Teaching for the journey.</h1>
        <p class="hero-copy">Authorized contributors can publish articles through the GitHub-backed CMS.</p>
        <div class="hero-actions"><a class="btn btn-primary" href="../admin/">Contributor Login</a><a class="btn btn-outline" href="../contact/">Request Access</a></div>
      </div>
      <div class="articles-layout">
        <aside class="articles-side-card">
          <p class="eyebrow">Publishing</p>
          <h3>Share what strengthens the church.</h3>
          <p>Articles are reviewed and published through the authorized GitHub CMS workflow.</p>
        </aside>
        <div class="article-grid article-grid-editorial">
        {articles.length > 0 ? articles.map(article => (
          <article class="article-card article-draft-card">
            {article.image && <img src={article.image} alt="" loading="lazy" />}
            <p class="draft-meta">By {article.author}{article.date ? ` • ${article.date}` : ''}</p>
            <h3>{article.title}</h3>
            <p>{article.excerpt}</p>
          </article>
        )) : (
          <article class="article-card"><h3>No articles yet</h3><p>Authorized contributors can add the first article through the CMS.</p></article>
        )}
        </div>
      </div>
    </section>
  </main>
  <script is:inline src="../scripts/main.js?v=20260609-map"></script>
</body>
</html>
