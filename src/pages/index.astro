---
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '';
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || 'https://analytics.umami.is/script.js';
---
<!DOCTYPE html>
<html lang="en" data-umami-website-id={umamiWebsiteId} data-umami-script-url={umamiScriptUrl}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mahanaim Christian Church | Faith, Hope & Loving Community</title>
  <meta name="description" content="Mahanaim Christian Church is a global Christian community centered on worship, Bible teaching, prayer, and fellowship." />
  <link rel="icon" type="image/png" href="./assets/mahanaim-logo.png" />
  <link rel="stylesheet" href="./style.css?v=20260609-map" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-header">
    <a class="brand" href="./" aria-label="Mahanaim Christian Church home">
      <img src="./assets/mahanaim-logo.png" alt="Mahanaim Christian Church logo" />
      <span><strong>Mahanaim</strong> Christian Church</span>
    </a>
    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
      <a href="./about/">About</a>
      <a href="./ministries/">Ministries</a>
      <a href="./sermons/">Sermons</a>
      <a href="./community/">Community</a>
      <a href="./events/">Events</a>
      <a href="./locations/">Locations</a>
      <a href="./articles/">Articles</a>
      <a href="./contact/">Contact</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" id="home">
      <div class="hero-media" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="eyebrow">Mahanaim Christian Welfare Association</p>
        <img class="hero-logo" src="./assets/mahanaim-logo.png" alt="" />
        <h1>Welcome Home</h1>
        <p class="hero-copy">Mahanaim Christian Church is a place to find faith, hope, and loving community.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="./locations/" data-cta="Visit Us">Visit Us</a>
          <a class="btn btn-ghost" href="./sermons/" data-cta="Watch Sermons">Watch Sermons</a>
          <a class="btn btn-outline" href="./ministries/" data-cta="Explore Ministries">Explore Ministries</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Explore</p>
        <h2>One place for every part of church life.</h2>
      </div>
      <div class="page-grid">
        <a class="feature-card page-card" href="./about/"><h3>About</h3><p>Our story, beliefs, and future story video.</p></a>
        <a class="feature-card page-card" href="./ministries/"><h3>Ministries</h3><p>Kids, youth, worship, groups, outreach, and serving.</p></a>
        <a class="feature-card page-card" href="./sermons/"><h3>Sermons</h3><p>Latest messages from the YouTube channel.</p></a>
        <a class="feature-card page-card" href="./community/"><h3>Community</h3><p>Meet the servants of God and church community.</p></a>
        <a class="feature-card page-card" href="./events/"><h3>Events</h3><p>Baptism and weekly Bible study gatherings.</p></a>
        <a class="feature-card page-card" href="./locations/"><h3>Locations</h3><p>Interactive map for India, Australia, and Dallas.</p></a>
        <a class="feature-card page-card" href="./articles/"><h3>Articles</h3><p>Devotions and teaching for the journey.</p></a>
        <a class="feature-card page-card" href="./contact/"><h3>Contact</h3><p>Reach out to Mahanaim Christian Church.</p></a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div><img src="./assets/mahanaim-logo.png" alt="Mahanaim Christian Church logo" /><p><strong>Mahanaim Christian Church</strong><br />Mahanaim Christian Welfare Association</p></div>
    <nav aria-label="Footer navigation"><a href="./about/">About</a><a href="./community/">Community</a><a href="./locations/">Locations</a><a href="./privacy/">Privacy</a></nav>
    <p>&copy; 2009 Mahanaim Christian Welfare Association. All rights reserved.</p>
  </footer>
  <script is:inline src="./scripts/analytics.js?v=20260609-map"></script>
  <script is:inline src="./scripts/main.js?v=20260609-map"></script>
</body>
</html>
